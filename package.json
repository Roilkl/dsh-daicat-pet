{
  "name": "dsh-daicat-pet",
  "version": "0.1.0",
  "description": "呆猫桌面宠物：在 DeepSeek Harness 网页里陪伴工作，能拖动、点击说话，并在每轮对话结束后报告本轮 token 消耗。图集列数、每状态帧数、循环次数全部由数据文件决定。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "assets",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "pet",
    "sprite",
    "daicat"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Roilkl/dsh-daicat-pet.git"
  },
  "homepage": "https://github.com/Roilkl/dsh-daicat-pet#readme",
  "bugs": {
    "url": "https://github.com/Roilkl/dsh-daicat-pet/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  }
}
